{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Soxu（索序）双端同源设计令牌唯一真相源（Single Source of Truth）。默认深色模式对标 ChatGPT Pure Black（零色偏中性灰阶 chroma=0 + OLED 纯黑画布），同时完整定义日光浅色模式，供 GPUI 桌面端（soxu-desktop）与内嵌响应式移动遥控端（apps/mobile-web）编译消费。",
  "meta": {
    "name": "Soxu Pure Black Design System",
    "version": "1.0.0",
    "defaultMode": "dark",
    "modes": ["dark", "light"],
    "neutralChroma": 0,
    "principles": [
      "Pure Black Canvas (#000000) + 7-tier neutral elevation without blue/purple cast",
      "Color is strictly reserved for semantic status and meaning, always paired with SVG icon or text label",
      "ChatGPT-style high-contrast inverse primary CTA (#FFFFFF fill / #000000 glyph in dark mode)",
      "Zero drift: CSS custom properties and Rust GPUI theme constants derive from this file"
    ]
  },
  "color": {
    "dark": {
      "$description": "ChatGPT Pure Black 默认主题（OLED 零发光主画布 + 7 级无色偏中性灰阶 + 高光描边塑形）",
      "surface": {
        "inset": { "$type": "color", "$value": "#000000", "$description": "凹陷井：代码行号槽、终端底槽、分段开关轨道底（配合 border.subtle 形成内凹感）" },
        "canvas": { "$type": "color", "$value": "#000000", "$description": "主对话画布与移动端全屏背景（Pure Black，正文对比度 17.8:1）" },
        "sidebar": { "$type": "color", "$value": "#0d0d0d", "$description": "左侧项目/Worktree 栏、右侧 Diff/脚本审阅栏、顶底状态横梁（#0D0D0D）" },
        "card": { "$type": "color", "$value": "#171717", "$description": "结构化工具调用卡、权限审批卡、Magpie 状态卡、设置分组容器（#171717）" },
        "cardMuted": { "$type": "color", "$value": "#121212", "$description": "卡片内部次级嵌块、折叠代码块头部、检查点横条底色" },
        "raised": { "$type": "color", "$value": "#212121", "$description": "ChatGPT 经典抬升表面：用户消息气泡、当前选中行、快捷指令胶囊（#212121）" },
        "composer": { "$type": "color", "$value": "#212121", "$description": "三态输入舱主体背景（#212121，聚焦时外描边提亮至 #383838）" },
        "floating": { "$type": "color", "$value": "#262626", "$description": "Cmd+K 命令面板、@agent 移交补全菜单、模型选择器弹层、模态对话框" },
        "control": { "$type": "color", "$value": "#2f2f2f", "$description": "输入舱内部次级胶囊按钮、胶囊选择器常态底色（#2F2F2F）" },
        "terminal": { "$type": "color", "$value": "#050505", "$description": "受控 PTY 终端与命令执行输出黑匣子底色" },
        "scrim": { "$type": "color", "$value": "rgba(0, 0, 0, 0.76)", "$description": "模态窗与移动端底部抽屉背景遮罩" },
        "headerGlass": { "$type": "color", "$value": "rgba(0, 0, 0, 0.82)", "$description": "移动端顶部浮动导航栏毛玻璃合成背景" }
      },
      "interaction": {
        "hover": { "$type": "color", "$value": "rgba(255, 255, 255, 0.05)", "$description": "列表行与次级按钮悬停态叠加层" },
        "selected": { "$type": "color", "$value": "rgba(255, 255, 255, 0.09)", "$description": "侧栏活跃会话/工作区选中态叠加层" },
        "pressed": { "$type": "color", "$value": "rgba(255, 255, 255, 0.13)", "$description": "按下瞬态反馈（80-120ms，严禁改变几何尺寸）" },
        "selection": { "$type": "color", "$value": "rgba(59, 130, 246, 0.35)", "$description": "文本选区高亮底色" }
