        "successSoft": { "$type": "color", "$value": "rgba(34, 197, 94, 0.13)", "$description": "成功徽章与 Diff 新增行背景" },
        "warning": { "$type": "color", "$value": "#f59e0b", "$description": "待人工权限审批（needs_input）、StandaloneNative 原生降级提示" },
        "warningSoft": { "$type": "color", "$value": "rgba(245, 158, 11, 0.14)", "$description": "审批卡片头部与排队等待衬底" },
        "warningBorder": { "$type": "color", "$value": "rgba(245, 158, 11, 0.38)", "$description": "待审批卡片高亮描边" },
        "danger": { "$type": "color", "$value": "#ef4444", "$description": "高危破坏性命令拦截、Interrupt 强行打断、未读错误、Git 删除行" },
        "dangerSoft": { "$type": "color", "$value": "rgba(239, 68, 68, 0.14)", "$description": "危险审批警告与 Diff 删除行背景" },
        "dangerBorder": { "$type": "color", "$value": "rgba(239, 68, 68, 0.40)", "$description": "Interrupt 模式与高危卡片描边" },
        "handoff": { "$type": "color", "$value": "#a855f7", "$description": "@agent 跨代理移交与 Git 轮次检查点（Checkpoint）专属识别色" },
