        "secondary": { "$type": "color", "$value": "#b4b4b4", "$description": "辅助文案、工具摘要、未激活页签（对 #000000 对比度 10.1:1，对 #171717 为 8.5:1）" },
        "tertiary": { "$type": "color", "$value": "#8e8e8e", "$description": "时间戳、Token 用量、快捷键提示、分组微标（对 #000000 为 6.3:1，对 #171717 为 5.3:1，满足 AA）" },
        "ghost": { "$type": "color", "$value": "#5e5e5e", "$description": "仅用于输入框 Placeholder、禁用态文本与纯装饰分隔符（禁止承载正文信息）" },
        "code": { "$type": "color", "$value": "#f4f4f5", "$description": "行内代码片段文字色" }
