        "strong": { "$type": "color", "$value": "#383838", "$description": "纯黑背景下浮层、输入舱聚焦态、模态框高光塑形描边" },
        "focusRing": { "$type": "color", "$value": "#ffffff", "$description": "键盘 Tab 导航高可见度焦点环（2px 偏移）" }
      },
      "action": {
        "inverse": { "$type": "color", "$value": "#ffffff", "$description": "主行动按钮（发送、允许一次、确认配对）纯白填充" },
        "inverseHover": { "$type": "color", "$value": "#e5e5e5", "$description": "主行动按钮悬停态" },
        "onInverse": { "$type": "color", "$value": "#000000", "$description": "主行动按钮上的纯黑文字与图标（对比度 21:1）" },
        "disabledBg": { "$type": "color", "$value": "#2a2a2a", "$description": "禁用主按钮背景" },
        "disabledFg": { "$type": "color", "$value": "#666666", "$description": "禁用主按钮前景" }
      },
      "semantic": {
        "accent": { "$type": "color", "$value": "#19c37d", "$description": "Soxu 品牌识别色 / Magpie 协同在线翠绿（仅作点缀，不作大面积背景）" },
        "accentSoft": { "$type": "color", "$value": "rgba(25, 195, 125, 0.14)", "$description": "品牌/协同态柔和衬底" },
